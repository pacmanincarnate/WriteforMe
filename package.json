{
  "name": "ellipsisprose",
  "version": "2.2.0",
  "description": "EllipsisProse AI-Powered Novel Writing Web Application",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/run-node20.mjs ./node_modules/vite/bin/vite.js",
    "build": "node scripts/run-node20.mjs ./node_modules/vite/bin/vite.js build && node scripts/run-node20.mjs scripts/check-precache.mjs",
    "build:singlefile": "node scripts/run-node20.mjs scripts/build-singlefile.mjs",
    "preview": "node scripts/run-node20.mjs ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node scripts/run-node20.mjs ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "node scripts/run-node20.mjs ./node_modules/eslint/bin/eslint.js src tests/unit",
    "test": "node scripts/run-node20.mjs ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/run-node20.mjs ./node_modules/vitest/vitest.mjs",
    "test:coverage": "node scripts/run-node20.mjs ./node_modules/vitest/vitest.mjs run --coverage",
    "test:golden": "node scripts/run-node20.mjs tests/e2e/golden_suite.mjs --mode local",
    "test:subpath": "node scripts/run-node20.mjs tests/e2e/golden_suite.mjs --mode subpath",
    "test:singlefile": "node scripts/run-node20.mjs tests/e2e/golden_suite.mjs --mode singlefile",
    "test:upgrade": "node scripts/run-node20.mjs tests/e2e/golden_suite.mjs --mode upgrade",
    "test:legacy": "node scripts/run-node20.mjs tests/e2e/golden_suite.mjs --mode legacy",
    "test:pipeline": "node scripts/run-node20.mjs tests/e2e/golden_suite.mjs --mode pipeline",
    "test:pipeline-parity": "node scripts/run-node20.mjs tests/e2e/golden_suite.mjs --mode pipeline-parity",
    "test:live": "node scripts/run-node20.mjs tests/e2e/golden_suite.mjs --mode live",
    "verify": "npm run typecheck && npm run lint -- --max-warnings=0 && npm test && npm run build",
    "test:e2e": "npm run test:golden && npm run test:subpath && npm run test:singlefile && npm run test:upgrade && npm run test:pipeline",
    "gate": "npm run verify && npm run build:singlefile && npm run test:e2e",
    "check": "node scripts/check.mjs",
    "check:quick": "node scripts/check.mjs --quick",
    "start": "node server.js",
    "serve": "node server.js",
    "launch": "node launch.js",
    "stop": "node stop.js",
    "audio-bridge": "node audio-studio-bridge.js",
    "codex-bridge": "node codex-bridge.js",
    "claude-bridge": "node claude-bridge.js",
    "mcp-server": "node mcp-server/index.mjs"
  },
  "optionalDependencies": {
    "@xenova/transformers": "2.17.2"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "sharp": "^0.35.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/opendyslexic": "^5.3.0",
    "dompurify": "^3.2.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.79.0",
    "mammoth": "^1.8.0",
    "marked": "^15.0.12",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-import-x": "^4.18.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^0.21.2",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
